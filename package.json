{
  "name": "fin-forecast-tw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "五年財務預估與銀行報表編修 App（本機運算，資料不外傳）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:app": "tsc --noEmit && vite build --config vite.single.config.ts && node scripts/rename-release.mjs",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "papaparse": "^5.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}